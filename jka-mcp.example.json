{
  "game_dir": "/path/to/JediAcademy",
  "home": "/path/to/jka-mcp-home",
  "fs_game": "japlus",
  "launcher": "gamescope",
  "renderer": "rd-vulkan-vision",
  "env": {
    "VK_DRIVER_FILES": "/usr/share/vulkan/icd.d/radeon_icd.json"
  },
  "reload": {
    "cwd": "/path/to/visionjk",
    "menus": [
      [
        "python3",
        "tools/menus/build.py"
      ],
      [
        "cmake",
        "--build",
        "build64",
        "--target",
        "zz_japlus_client_assets"
      ]
    ],
    "menus_copy": [
      [
        "/path/to/visionjk/assets/japlus_client/ui",
        "ui"
      ],
      [
        "/path/to/visionjk/assets/japlus_client/strings",
        "strings"
      ]
    ],
    "modules": [
      [
        "cmake",
        "--build",
        "build64",
        "--target",
        "uix86_64",
        "cgamex86_64"
      ]
    ],
    "modules_copy": [
      [
        "/path/to/visionjk/build64/codemp/ui/uix86_64.so",
        "japlus/uix86_64.so"
      ],
      [
        "/path/to/visionjk/build64/codemp/cgame/cgamex86_64.so",
        "japlus/cgamex86_64.so"
      ]
    ],
    "menus_put": [
      [
        "/path/to/visionjk/build64/assets/zz_japlus_client_assets.pk3",
        "japlus/zz_japlus_client_assets.pk3"
      ]
    ]
  }
}